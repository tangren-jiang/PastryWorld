  lines:
  - speakerName: "\u5185\u5FC3"
    text: "\uFF08\u644A\u5F00\u7684\u7A3F\u7EB8\uFF0C\u505C\u5728\u6628\u5929\u5199\u5230\u4E00\u534A\u7684\u5730\u65B9\u3002\uFF09"
  - speakerName: "\u5185\u5FC3"
    text: "\uFF08\u90A3\u676F\u8336\u51C9\u900F\u4E86\u3002\u6211\u7ADF\u7136\u6CA1\u6709\u5BDF\u89C9\u3002\uFF09"
  - speakerName: "\u5185\u5FC3"
    text: "\uFF08\u5199\u4E0B\u53BB\u3002\u4E5F\u8BB8\u5199\u4E0B\u53BB\uFF0C\u5C31\u80FD\u60F3\u660E\u767D\u4E00\u70B9\u4EC0\u4E48\u3002\uFF09"
